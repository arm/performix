{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compatibility Matrix Schema",
  "type": "object",
  "required": ["version", "compatibility"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^(NEXT_VERSION|\\d+\\.\\d+\\.\\d+)$"
        },
        "additionalProperties": {
          "type": "object",
          "required": ["minimum_version"],
          "properties": {
            "minimum_version": {
              "type": "string",
              "pattern": "^(NEXT_VERSION|\\d+\\.\\d+\\.\\d+)$"
            }
          }
        }
      }
    }
  }
}
