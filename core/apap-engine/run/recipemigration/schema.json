{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe Name Migrations Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["from", "to", "version"],
    "properties": {
      "from": {
        "type": "string"
      },
      "to": {
        "type": "string"
      },
      "version": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
      }
    }
  }
}
