# NPM local files
.npmrc
!core/.npmrc
.eslintcache
node_modules/

# Ignore nested AGENTS.md files by default, but keep the top-level repo policy tracked
**/AGENTS.md
!/AGENTS.md
AGENTS.override.md
# Local agent configuration files
.agents/private

.codex

# Don't check in auto-generated Go code
core/apap-engine/message/codes.go

# License terms
# They are generated during CI, but we don't want to check them in to avoid
# dirty git state and accidental modifications.
core/license_terms/
gui/installer-resources/license_terms/third_party_licenses
gui/installer-resources/license_terms/redistributables.txt

# AI prompt plans (default location for AI-generated plans used by Copilot)
.github/prompts/
